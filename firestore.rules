rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow user to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow user to create their document as long as they don't set isPremium to true
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);

      // Allow user to update their document as long as they don't change isPremium
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == resource.data.isPremium);

      // Allow user to access their login history
      match /login_history/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
